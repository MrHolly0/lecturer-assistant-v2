# Pinned versions of everything the cluster installs. Change deliberately, one at a time.
K3S_VERSION=v1.35.10+k3s1
UBUNTU_IMAGE=template:_images/ubuntu-24.04
CERT_MANAGER_MANIFEST=https://github.com/cert-manager/cert-manager/releases/download/v1.21.3/cert-manager.yaml
CNPG_MANIFEST=https://github.com/cloudnative-pg/cloudnative-pg/releases/download/v1.28.4/cnpg-1.28.4.yaml
RABBITMQ_OPERATOR_MANIFEST=https://github.com/rabbitmq/cluster-operator/releases/download/v2.23.2/cluster-operator.yml
KEDA_MANIFEST=https://github.com/kedacore/keda/releases/download/v2.21.0/keda-2.21.0.yaml
REGISTRY_IMAGE=registry:3.1.2
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
# Operator 2.23 probes /api/health/checks/reached-target-cluster-size, which needs RabbitMQ 4.2+.
RABBITMQ_IMAGE=rabbitmq:4.2-alpine
REDIS_IMAGE=redis:7.4-alpine
CADDY_IMAGE=caddy:2.8-alpine
# Linux servers build images with a separate containerd + BuildKit from nerdctl-full (checked by SHA256SUMS).
NERDCTL_VERSION=2.4.2
