{
	# Адрес для уведомлений Let's Encrypt о сроке сертификата.
	email {$ACME_EMAIL}
}

# SITE_ADDRESS на VPS — домен стенда: сертификат выпускается автоматически у
# Let's Encrypt (MAX не принимает самоподписанные сертификаты и вебхуки по HTTP).
# В режиме туннеля SITE_ADDRESS=:80 — HTTPS снаружи обеспечивает ngrok.
{$SITE_ADDRESS} {
	# Streaming events must not wait for a compression buffer to fill.
	@compressible not path /api/v1/student/sessions/*/events /api/v1/student/sessions/*/events/public
	encode @compressible gzip
	@studentEvents path /api/v1/student/sessions/*/events /api/v1/student/sessions/*/events/public
	header @studentEvents Cache-Control "no-cache, no-transform"

	request_body {
		max_size 100MB
	}

	header Strict-Transport-Security "max-age=31536000"

	# Вебхук MAX: адаптер сам сверяет путь и заголовок x-max-bot-api-secret.
	handle /webhook/* {
		reverse_proxy max-adapter:8090
	}

	# Проверка доступности для внешнего мониторинга.
	handle /health {
		rewrite * /actuator/health
		reverse_proxy core:8080
	}

	handle /api/* {
		@json header Content-Type application/*json*
		request_body @json {
			max_size 4MiB
		}
		reverse_proxy core:8080
	}

	handle /ws/* {
		reverse_proxy core:8080
	}

	handle {
		reverse_proxy web:80
	}
}
