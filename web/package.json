    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tanstack/react-query": "5.24.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
