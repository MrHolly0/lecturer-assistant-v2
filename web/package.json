{
  "name": "lecturer-assistant-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "gen:api": "openapi-typescript ../openapi/lecturer-assistant-v2.yaml -o src/app/api/schema.ts && prettier --write src/app/api/schema.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
