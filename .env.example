# Образец .env. Скопируйте в .env: cp .env.example .env
# Для локального запуска достаточно пустых значений: compose подставит безопасные только
# для локальной машины значения по умолчанию. Для стенда секреты генерирует
# sh deploy/stand/init-env.sh (туннель) или sh deploy/stand/init-env.sh --vps (сервер).
# Реальные значения храните только в .env и в менеджере паролей, в git их нет.

# ---------- База данных (PostgreSQL) ----------
# Имя базы, пользователь и пароль, с которыми Postgres создаёт базу при первом запуске тома.
# Смена пароля позже не меняет его в уже созданной базе.
POSTGRES_DB=lecturer_assistant
POSTGRES_USER=lecturer
# Пароль БД. Локально пусто = lecturer_dev_password. На стенде — случайная строка (init-env.sh).
POSTGRES_PASSWORD=
# Подключение core к базе. DB_PASSWORD должен совпадать с POSTGRES_PASSWORD
# (в prod-оверлее core берёт POSTGRES_PASSWORD напрямую).
DB_URL=jdbc:postgresql://postgres:5432/lecturer_assistant
DB_USERNAME=lecturer
DB_PASSWORD=

# ---------- Порты на хосте ----------
# Веб-интерфейс (и прокси к API): http://localhost:WEB_PORT
WEB_PORT=3000
# API core, только 127.0.0.1. Для проверки API напрямую; веб к нему не обращается.
CORE_PORT=8080
# PostgreSQL, только 127.0.0.1. Меняйте, если 5432 занят.
POSTGRES_PORT=5432

# ---------- Безопасность ----------
# Ключ подписи JWT, не короче 32 символов и без «change-me». Локально пусто = дев-ключ.
# Сгенерировать: openssl rand -hex 48
JWT_SECRET=
# true — core не стартует со слабым JWT_SECRET. В prod-оверлее всегда true.
REQUIRE_STRONG_JWT_SECRET=false
# Ключ подписи временных ссылок на картинки слайдов. openssl rand -hex 48
SLIDE_IMAGE_URL_SECRET=
# Срок жизни ссылки на картинку слайда, ISO-8601 (PT1H — час).
SLIDE_IMAGE_URL_TTL=PT1H
# Срок жизни access-токена, минуты.
ACCESS_TOKEN_MINUTES=15
# Срок жизни refresh-токена, дни.
REFRESH_TOKEN_DAYS=30
# Флаг Secure у refresh-cookie. Chrome и Firefox принимают его и на http://localhost;
# если локально по http вход сбрасывается после перезагрузки страницы — поставьте false.
REFRESH_COOKIE_SECURE=true

# Origin, которым разрешены CORS и WebSocket (через запятую). Пусто — адрес локального
# веба http://localhost:WEB_PORT. На стенде задаётся автоматически: https://SITE_DOMAIN.
APP_CORS_ALLOWED_ORIGINS=
# Лимит запросов с одного IP в минуту на вход через MAX и на сигналы студентов.
RATE_LIMIT_AUTH_MAX_PER_MINUTE=120
RATE_LIMIT_SIGNAL_PER_MINUTE=120

# ---------- MAX ----------
# Токен бота: платформа MAX для партнёров → «Чат-боты» → бот → «Расширенные настройки».
# Нужен core (проверка initData мини-приложения) и адаптеру MAX. Без него вход через MAX
# отвечает 503, а адаптер MAX не запускается.
MAX_BOT_TOKEN=
# Публичное имя бота без https://max.ru/; встраивается в web-образ при сборке.
# После изменения пересоберите web: docker compose build web.
VITE_MAX_BOT_NAME=
# Максимальный возраст initData при входе через MAX, ISO-8601.
MAX_INIT_DATA_MAX_AGE=PT1H
# Адрес мини-приложения, как в кабинете MAX (https://<домен>/). На стенде задаётся
# автоматически из SITE_DOMAIN, вручную — только для локального адаптера.
MAX_WEBAPP_URL=
# Вебхук бота. Пусто — адаптер работает через long polling (для локальной разработки).
# На стенде MAX_WEBHOOK_URL собирается из SITE_DOMAIN и MAX_WEBHOOK_PATH автоматически.
MAX_WEBHOOK_URL=
# Секрет, который MAX присылает в заголовке x-max-bot-api-secret. openssl rand -hex 32
MAX_WEBHOOK_SECRET=
# Путь вебхука, лучше случайный: /webhook/<openssl rand -hex 24>.
MAX_WEBHOOK_PATH=
# Ограничение частоты запросов адаптера к MAX Bot API (лимит MAX — 30 в секунду).
MAX_RATE_LIMIT_RPS=15

# ---------- Каналы ----------
# Общий ключ core и адаптеров каналов (заголовок X-Internal-Api-Key). openssl rand -hex 32
CHANNEL_INTERNAL_API_KEY=
# Как часто core проверяет очередь исходящих сообщений в каналы, мс.
CHANNEL_DELIVERY_WORKER_DELAY_MS=5000
# Имена ботов для окна «Подключение» (QR и ссылки). Пусто — канал в окне не показывается.
TELEGRAM_BOT=
VK_BOT=
# Токен Telegram-бота от @BotFather. Пусто — адаптер Telegram не запускается.
TELEGRAM_BOT_TOKEN=

# ---------- Загрузка и конвертация презентаций ----------
# Максимальный размер файла: проверка приложения (байты) и лимит Spring (с единицами).
MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_SIZE=100MB
# Таймауты обращения core к конвертеру, ISO-8601. Большие PPTX конвертируются минутами.
CONVERTER_CONNECT_TIMEOUT=PT5S
CONVERTER_READ_TIMEOUT=PT20M
# Пул фоновых задач импорта: сколько презентаций конвертируется одновременно и сколько ждёт.
CONTENT_IMPORT_CORE_POOL_SIZE=1
CONTENT_IMPORT_MAX_POOL_SIZE=2
CONTENT_IMPORT_QUEUE_CAPACITY=8

# ---------- Прочее ----------
# Версия, которую показывает GET /api/v1/system/info.
APP_VERSION=0.0.1-SNAPSHOT
# SERVER_PORT (8080) и BLOB_ROOT (/data/blobs) заданы в docker-compose.yml и из .env
# не меняются: от них зависят healthcheck, прокси и том с файлами.

# ---------- Тестовые данные (docker compose run --rm seed) ----------
# Пароли тестовых учёток admin@, lecturer@, assistant@lecturer-assistant.test, не короче
# 8 символов. Жюри получает их по закрытому каналу, в репозитории их нет.
SEED_PASSWORD_ADMIN=
ADMIN_SETUP_TOKEN=
SEED_PASSWORD_LECTURER=
SEED_PASSWORD_ASSISTANT=

# ---------- Стенд ----------
# Домен стенда на VPS (A-запись на сервер). Для туннеля его подставляет tunnel.sh.
SITE_DOMAIN=
# Почта для уведомлений Let's Encrypt о сертификате (только VPS).
ACME_EMAIL=
# Постоянный адрес внешнего туннеля (Tuna и т.п.), клиент которого смотрит на
# 127.0.0.1:TUNNEL_PORT. Задан — tunnel.sh не запускает ngrok. Сейчас:
# lecturer-assistant.ru.tuna.am
PUBLIC_DOMAIN=
# Постоянный бесплатный домен ngrok (кабинет ngrok → Domains). Пусто — адрес меняется
# при каждом перезапуске туннеля.
NGROK_DOMAIN=
# Локальный порт Caddy, на который смотрит туннель.
TUNNEL_PORT=18088
# Сколько дней хранить ежедневные копии базы.
BACKUP_KEEP_DAYS=14
