POSTGRES_DB=lecturer_assistant
POSTGRES_USER=lecturer
POSTGRES_PASSWORD=lecturer_dev_password
DB_URL=jdbc:postgresql://postgres:5432/lecturer_assistant
DB_USERNAME=lecturer
DB_PASSWORD=lecturer_dev_password
CORE_PORT=8080
WEB_PORT=3000
# Quick tunnel does not require a token. Reserved for a future named tunnel setup.
CLOUDFLARED_TOKEN=
JWT_SECRET=change-me-to-a-long-random-secret
REQUIRE_STRONG_JWT_SECRET=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_SECURE=true
BLOB_ROOT=/data/blobs
MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_SIZE=100MB
